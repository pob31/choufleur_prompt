# Rust
server/target/
**/*.rs.bk

# Models — fetched by scripts/fetch-models.sh, never committed. They are hundreds
# of megabytes and carry their own licence (MIT, OpenAI / snakers4).
server/models/

# Corpus audio lives on external storage; manifests, scripts and ground truth are
# committed, and the manifest's SHA-256 per file is what ties the two together.
corpus/**/*.wav
corpus/**/*.aiff
corpus/**/*.flac
corpus/**/audio/

# ...except the synthetic fixtures, which are generated rather than recorded. Their
# hashes depend on the local speech synthesis, so committing them would produce
# spurious diffs. Regenerate with:
#   choufleur-replay make-fixture corpus/fixture-smoke
#   choufleur-replay make-fixture corpus/fixture-load  --load-test 4
corpus/fixture-*/

# Replay outputs.
#
# Scoped deliberately. An earlier repo-wide `*.jsonl` also swallowed committed
# test fixtures — a golden trace under tests/ is exactly the artifact the devplan's
# regression strategy calls for, and `git add -A` skipped it in silence. Ignore
# where the outputs actually land instead: the default `out/`, and the repository
# root for when someone runs `-o segments.jsonl` from there.
out/
/*.jsonl
/report.json

# Python research sidecar
research/.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# macOS
.DS_Store
# Resource forks. macOS scatters these across any non-HFS volume, which is exactly
# what the corpus audio drive will be.
._*
.Spotlight-V100
.Trashes
.fseventsd

# Editors
.vscode/
.idea/
*.swp
*~
test_Choufleur/
