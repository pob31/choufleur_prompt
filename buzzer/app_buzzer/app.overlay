/*
 * One overlay for either XIAO nRF52840, base or Sense — app.overlay applies to
 * whatever board the app is built for, and the pins below are identical on both.
 *
 * The DRV2605L sits on the edge-pin I2C (D4/P0.04 SDA, D5/P0.05 SCL), which the
 * board calls xiao_i2c — it is i2c1. Not i2c0: on the Sense that is the internal
 * bus carrying the IMU (P0.07/P0.27), and on the base board it is nothing at all.
 * The node uses the ti,drv2605 binding so the properties are checked, but no
 * driver binds to it (CONFIG_HAPTICS off) — haptic.c owns the registers directly
 * for calibration and the idle power path. See buzzer/README.md.
 *
 * The tryout breakouts — Adafruit 2305, Pimoroni PIM452 — expose no EN pin, so
 * idle power-down is the chip's standby bit (~5 µA). A bare-chip build that
 * wires EN adds to the node:
 *     en-gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;    (D10/P1.15)
 * and gets hard shutdown instead; the firmware adapts to either.
 *
 * Per-actuator values — the whole swap lives in these numbers (and the effect
 * vocabulary auditioned with opcode 0x07):
 *
 *   PUI HD-LA0803-LW10-R      "LRA"  rated 1400  overdrive 1750  freq 235 (*)
 *   ELV1411A (on the PIM452)  "LRA"  rated 1400  overdrive 1750  freq 200 (**)
 *   3 V coin ERM              "ERM"  rated 3000  overdrive 3300  freq unused
 *
 * (*) Both LRAs are 2 Vrms parts (PUI datasheet: 2 Vrms, 235 Hz, 25 Ω, 90 mA).
 * On the 3.3 V rail the DRV2605L cannot reach that plus overdrive: a ratings
 * sweep (opcode 0x09) locks at 0.8-1.4 V and refuses from 1.6 V. 1400 is the
 * rail's ceiling, about 70 % of the rating, and is what two people felt on five
 * sites. Once the rating fits the rail, every seed from 100 to 300 Hz locks.
 * (**) A reseller page said 150 Hz; the chip disagrees. Swept from the page with
 * opcode 0x08: 150 fails auto-cal every time, 170 through 235 all lock with
 * identical results. 200 sits in the middle of what works.
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-adc.h>

/ {
	zephyr,user {
		/* Battery: VBAT through the board's 1 M / 510 k divider onto
		 * P0.31 (AIN7); P0.14 low switches the divider in. */
		io-channels = <&adc 7>;
		vbatt-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
		/* Resonant frequency of the fitted LRA; ignored for an ERM. */
		lra-freq-hz = <200>;  /* PIM452 / ELV1411A: 150 fails auto-cal, 170-235 all lock */
	};
};

&xiao_i2c {
	status = "okay";

	drv2605: drv2605@5a {
		compatible = "ti,drv2605";
		reg = <0x5a>;
		actuator-mode = "LRA";
		vib-rated-mv = <1400>;
		vib-overdrive-mv = <1750>;
	};
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
		zephyr,resolution = <12>;
	};
};
